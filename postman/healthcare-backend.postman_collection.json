    },
    {
      "name": "5. Negative and Security Tests",
      "item": [
        {
          "name": "Register with Duplicate Email (Expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"student@campus.edu\",\n  \"password\": \"AnotherPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", ""]
            }
          }
        },
        {
          "name": "Login with Wrong Password (Expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@campus.edu\",\n  \"password\": \"IncorrectPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login", ""]
            }
          }
        },
        {
          "name": "Access Patients Without Token (Expect 401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/patients/",
              "host": ["{{baseUrl}}"],
              "path": ["patients", ""]
            }
          }
        },
        {
          "name": "Access Nonexistent Patient (Expect 404)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/patients/00000000-0000-0000-0000-000000000000/",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "00000000-0000-0000-0000-000000000000", ""]
            }
          }
        },
        {
          "name": "Delete Doctor with Active Mappings (Expect 409)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}", ""]
            }
          }
        },
        {
          "name": "Unknown Route Test (Expect 404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/non-existent-api-path",
              "host": ["{{baseUrl}}"],
              "path": ["non-existent-api-path"]
            }
          }
        }
      ]
    }
  ]
